# Force LF line endings in the repo for all text files.
# This ensures Python scripts run cleanly on the Jetson (Linux)
# regardless of what OS edits them.

* text=auto eol=lf

# Explicitly mark Python files as text with LF
*.py text eol=lf

# Also mark config/text files
*.txt text eol=lf
*.md  text eol=lf
*.env text eol=lf
*.json text eol=lf
